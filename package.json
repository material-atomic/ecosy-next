{
  "name": "@ecosy/next",
  "version": "1.0.1",
  "description": "Ecosy Next.js bindings",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./inject": {
      "source": "./src/inject.ts",
      "types": "./dist/inject.d.ts",
      "import": "./dist/inject.mjs",
      "require": "./dist/inject.js"
    },
    "./jwt": {
      "source": "./src/jwt.ts",
      "types": "./dist/jwt.d.ts",
      "import": "./dist/jwt.mjs",
      "require": "./dist/jwt.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && rollup -c",
    "prepublishOnly": "yarn clean && yarn build",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/material-atomic/ecosy-next.git"
  },
  "author": "material-atomic",
  "peerDependencies": {
    "next": "^16.3.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "server-only": "^0.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "jsonwebtoken": {
      "optional": true
    }
  },
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "README.md"
  ]
}
