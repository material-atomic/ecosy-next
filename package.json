{
  "name": "@ecosy/next",
  "version": "1.0.0",
  "description": "Ecosy Next.js bindings",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./inject": {
      "source": "./src/inject.ts",
      "types": "./dist/inject.d.ts",
      "default": "./src/inject.ts"
    },
    "./jwt": {
      "source": "./src/jwt.ts",
      "types": "./dist/jwt.d.ts",
      "default": "./src/jwt.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/material-atomic/ecosy-next.git"
  },
  "author": "material-atomic",
  "peerDependencies": {
    "next": "^16.3.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.1",
    "server-only": "^0.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "jsonwebtoken": {
      "optional": true
    }
  }
}
